{
  "name": "react-native-gradient-header",
  "version": "1.0.0",
  "description": "Fully customizable and unique shape Gradient Header for React Native.",
  "keywords": [
    "react-native",
    "ios",
    "android",
    "gradient",
    "header",
    "gradient-header",
    "ui-component",
    "typescript",
    "expo"
  ],
  "homepage": "https://github.com/kuraydev/react-native-gradient-header#readme",
  "bugs": {
    "url": "https://github.com/kuraydev/react-native-gradient-header/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraydev/react-native-gradient-header.git"
  },
  "license": "MIT",
  "author": "Kuray (FreakyCoder) <kurayogun@gmail.com>",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.tsx",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "assets/profile.jpg",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "clean": "del-cli lib",
    "build": "bob build",
    "prepare": "bob build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-linear-gradient": ">=2.8.0",
    "@freakycoder/react-native-helpers": ">=0.1.2"
  },
  "peerDependenciesMeta": {
    "react-native-linear-gradient": {
      "optional": false
    },
    "@freakycoder/react-native-helpers": {
      "optional": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/babel-preset": "0.73.21",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.6",
    "del-cli": "^5.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-builder-bob": "^0.30.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3",
    "@freakycoder/react-native-helpers": "^0.1.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
